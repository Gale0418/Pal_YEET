# Explicit safety fences for common local/generated material. These are kept
# here as documentation too, even though the deny-by-default rule above also
# covers them.
vendor/
dist/
downloads/
epic_appdata/
epic_local/
epic_temp/
Intermediate/
Binaries/
Saved/
output/
MissionCenter/
runtime-backups/
Workshop/
