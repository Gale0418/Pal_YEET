# Repository policy: keep the Git index to the small, first-party source allowlist
# below. Everything else (including local game data and generated build output)
# remains ignored by default.
*

# Repository metadata/configuration
!.gitignore
!.coderabbit.yaml

# First-party contracts and readme
!LogicMods/
!LogicMods/YEET/
!LogicMods/YEET/BUILD-CONTRACT.json
!LogicMods/YEET/INTERACTION-CONTRACT.json
!LogicMods/YEET/README.md
!LogicMods/YEET/ROUTE-UI-CONTRACT.json

!PalSchema/
!PalSchema/README.md
!PalSchema/mods/
!PalSchema/mods/YEETTerminal/
!PalSchema/mods/YEETTerminal/buildings/
!PalSchema/mods/YEETTerminal/buildings/yeet_terminal.jsonc

# First-party test specifications
!tests/
!tests/domain_spec.lua
!tests/inventory_adapter_spec.lua
!tests/inventory_runtime_spec.py
!tests/main_inventory_integration_spec.py
!tests/main_pal_reservation_integration_spec.py
!tests/main_terminal_integration_spec.py
!tests/main_ui_integration_spec.py
!tests/pal_reservation_runtime_spec.py
!tests/run-lua-specs.py
!tests/run-yeet-specs.ps1
!tests/state_store_spec.lua
!tests/terminal_interaction_bridge_spec.py

# First-party maintenance and validation scripts (the bundled dotnet runtime
# and its installer are intentionally excluded).
!tools/
!tools/deploy-yeet-local-workshop.ps1
!tools/deploy-yeet-palschema.ps1
!tools/deploy-yeet-runtime-probe.ps1
!tools/package-yeet-workshop.ps1
!tools/probe-terminal-cooked-asset.ps1
!tools/rewrite-terminal-cooked-asset.ps1
!tools/switch-to-managed-yeet.ps1
!tools/validate-yeet-core.ps1
!tools/validate-yeet-ui-slice.ps1
!tools/validate-yeet-workshop.ps1
!tools/verify-yeet-runtime.ps1

# First-party UE4SS mods
!UE4SS/
!UE4SS/Mods/
